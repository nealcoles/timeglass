<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Timeglass.Testing is a shared helper library (fakes, builders), not a test project. -->
  <PropertyGroup>
    <IsTimeglassTestProject Condition="'$(MSBuildProjectName)' != 'Timeglass.Testing'">true</IsTimeglassTestProject>
    <IsPackable>false</IsPackable>
    <!-- CA1707: underscores in test method names are fine. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTimeglassTestProject)' == 'true'">
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsTimeglassTestProject)' == 'true'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsTimeglassTestProject)' == 'true'">
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>
</Project>
