<?xml version="1.0" encoding="utf-8"?>
<!--
  Code coverage settings, used as: dotnet test (solution) with settings coverage.runsettings.
  Thresholds are checked by build/check-coverage.py in CI (see #5).
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Test helpers are not product code. -->
          <Exclude>[Timeglass.Testing]*</Exclude>
          <!-- Source generated code (regex, System.Text.Json contexts, CsWin32) is not ours to test. -->
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <ExcludeByFile>**/obj/**/*</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
          <DeterministicReport>false</DeterministicReport>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
