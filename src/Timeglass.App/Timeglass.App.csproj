<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Timeglass.App</RootNamespace>
    <AssemblyName>Timeglass</AssemblyName>
    <ApplicationIcon>Assets\timeglass.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timeglass.Core\Timeglass.Core.csproj" />
    <ProjectReference Include="..\Timeglass.Storage\Timeglass.Storage.csproj" />
    <ProjectReference Include="..\Timeglass.Api\Timeglass.Api.csproj" />
    <ProjectReference Include="..\Timeglass.Windows\Timeglass.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic host: DI, configuration, logging and lifetime. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray icons: normal and paused. -->
    <EmbeddedResource Include="Assets/*.ico" LogicalName="Timeglass.App.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Timeglass.App.Tests" />
  </ItemGroup>

</Project>
