<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>Timeglass.Windows</RootNamespace>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- CsWin32 generates unsafe interop code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Timeglass.Core\Timeglass.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Win32 APIs to generate are listed in NativeMethods.txt. -->
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Timeglass.Windows.IntegrationTests" />
  </ItemGroup>

</Project>
